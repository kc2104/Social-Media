# --- Required -------------------------------------------------------------
# Access token from YOUR Meta app (never commit the real one).
# Facebook Login flow: a long-lived User token or a Page token.
META_ACCESS_TOKEN=

# --- Optional -------------------------------------------------------------
# Instagram professional account ID. If empty, it is discovered from your Pages.
META_IG_USER_ID=
# Facebook Page linked to the Instagram account (only needed if you manage several Pages).
META_PAGE_ID=
# Graph API version.
META_GRAPH_VERSION=v23.0
# Use https://graph.instagram.com if your token comes from "Instagram API with Instagram Login".
META_GRAPH_BASE=https://graph.facebook.com

# --- Safety ---------------------------------------------------------------
# Writes (publish, reply, DM, hide) are OFF unless this is exactly "true".
META_ALLOW_WRITES=false
# Hard cap on write actions per rolling hour (protects the account from spam flags).
META_MAX_WRITES_PER_HOUR=30
# Minimum delay between any two Graph API calls, in ms.
META_MIN_INTERVAL_MS=300

# --- Local content calendar ------------------------------------------------
CALENDAR_FILE=./data/calendar.json

# --- Hosted mode (src/http.js) for claude.ai / ChatGPT / Gemini ---------------
# Public https URL of your deployed server (no trailing slash).
PUBLIC_URL=
# Random 32+ chars, e.g. `openssl rand -hex 32`. Signs OAuth tokens; changing it logs every AI app out.
MCP_SIGNING_SECRET=
# 12+ chars. You type it on the consent page when connecting an AI app. Only you should know it.
MCP_ADMIN_PASSWORD=
# Optional: static bearer token for clients that can send an Authorization header (CLIs, API).
MCP_BEARER_TOKEN=
PORT=8787
